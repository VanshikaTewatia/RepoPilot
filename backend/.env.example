# ==============================================================================
# RepoPilot Environment Configuration
# ==============================================================================

# Application
APP_NAME=RepoPilot
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Gemini AI / LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repopilot
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here

# Workspace & Sandbox Storage
WORKSPACE_DIR=./storage/workspaces
DOCKER_SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=45
SANDBOX_MAX_CPU=2.0
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_NETWORK_MODE=none

# Agent Configuration
AGENT_MAX_ITERATIONS=3
VECTOR_TOP_K=10
